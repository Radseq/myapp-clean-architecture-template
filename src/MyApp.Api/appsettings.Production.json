{
  "ConnectionStrings": {
    "Default": "__SET_VIA_SECRET_OR_ENV__",
    "Redis": "__SET_VIA_SECRET_OR_ENV__"
  },

  "TransportApi": {
    "BaseUrl": "__SET_VIA_ENV__"
  },

  "Caching": {
    "UseRedis": true,
    "KeyPrefix": "myapp-prod"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",

      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning",

      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.Extensions.Hosting": "Information",

      "Microsoft.EntityFrameworkCore.Database.Command": "None",

      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Warning",

      "MyApp": "Information"
    }
  },

  "Observability": {
    "Logging": {
      "UseNLog": true,
      "NLogConfigFile": "nlog.config",
      "FileEnabled": null,
      "LogDirectory": null,
      "FileMaxArchiveFiles": 20,
      "DiagnosticsEnabled": false
    },

    "RequestLogging": {
      "LogQueryString": false,
      "LogHeaders": false,
      "MaxValueLength": 256,
      "HeaderAllowList": [ "User-Agent", "Accept", "Accept-Language", "X-Correlation-ID" ],
      "HeaderDenyList": [ "Authorization", "Cookie", "Set-Cookie", "X-Api-Key" ],
      "QueryStringDenyList": [ "password", "token", "access_token", "refresh_token", "client_secret", "code" ]
    },

    "BodyLogging": {
      "Enabled": true,
      "Mode": "OnError",
      "MaxBytes": 4096,
      "MaxRequestContentLengthToCapture": 32768,
      "ContentTypesAllowList": [ "application/json", "application/problem+json", "text/plain" ],
      "JsonDenyPaths": [ "password", "token", "access_token", "refresh_token", "client_secret" ],

      "Store": {
        "Mode": "Sql",
        "TtlMinutes": 60,
        "KeyPrefix": "failed-http"
      }
    }
  }

  "AllowedHosts": "*"
}
